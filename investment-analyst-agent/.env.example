# ── IBM watsonx.ai ───────────────────────────────────────────────────────────
WATSONX_API_KEY=your_watsonx_api_key_here
WATSONX_URL=https://au-syd.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your_project_id_here
GRANITE_MODEL_ID=ibm/granite-13b-instruct-v2

# ── IBM Cloud Object Storage ──────────────────────────────────────────────────
COS_API_KEY=your_cos_api_key_here
COS_INSTANCE_CRN=your_cos_instance_crn_here
COS_BUCKET=investment-analyst-reports
COS_ENDPOINT=https://s3.au-syd.cloud-object-storage.appdomain.cloud

# ── News API (optional — falls back to RSS if not set) ────────────────────────
NEWS_API_KEY=your_newsapi_key_here

# ── Mock mode — set to true to run fully offline with synthetic data ──────────
MOCK_MODE=false
